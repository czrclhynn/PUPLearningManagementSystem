DB_CONNECTION=pgsql
DB_HOST=db.example-project.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password
DB_SSLMODE=require
# Set both for certificate and hostname verification.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/supabase-ca.crt
# Use true when the site is served over HTTPS.
# SESSION_COOKIE_SECURE=true
