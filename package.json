{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:api": "corepack pnpm --dir apps/api build",
    "preview": "vite preview",
    "dev:api": "corepack pnpm --dir apps/api dev",
    "db:migrate": "corepack pnpm --dir apps/api migrate",
    "db:bootstrap-admin": "corepack pnpm --dir apps/api bootstrap-admin",
    "format": "oxfmt src apps/api e2e .github index.html package.json pnpm-workspace.yaml eslint.config.js vitest.config.ts playwright.config.ts",
    "format:check": "oxfmt --check src apps/api e2e .github index.html package.json pnpm-workspace.yaml eslint.config.js vitest.config.ts playwright.config.ts",
    "lint": "eslint src apps/api",
    "typecheck": "tsc --noEmit && corepack pnpm --dir apps/api typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm build:api"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.3"
}
